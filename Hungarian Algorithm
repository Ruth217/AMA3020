import numpy as np
from scipy.optimize import linear_sum_assignment
import pandas as pd

# -----------------------------
# STEP 0: GENERATE CHOICES
# ---------------------------
Students = list(range(1, 11))
Assign = list(range(1, 20))

choices = {}
assignment_rank = {}

HIGH_COST = 999

for student in Students:
    k = np.random.randint(5, 10)
    picks = np.random.choice(Assign, k, replace=False).tolist()
    choices[student] = picks

    assignment_rank[student] = {
        assignment: rank
        for rank, assignment in enumerate(picks, start=1)
    }

# Example: print rankings
for student in Students:
    print(f"Student {student}:")
    for assignment, rank in sorted(assignment_rank[student].items(), key=lambda x: x[1]):
        print(f"  Rank {rank}: Assignment {assignment}")
    print()

# -----------------------------
# STEP 1: SYMMETRIC PAIR MATRIX
# -----------------------------
n = len(Students)
pair_cost_matrix = np.full((n, n), HIGH_COST, dtype=int)

print("\n=== Building Symmetric Pair Compatibility Matrix ===")

for i, s1 in enumerate(Students):
    for j, s2 in enumerate(Students):
        if i < j:
            best_cost = min(
                assignment_rank[s1].get(A, HIGH_COST) +
                assignment_rank[s2].get(A, HIGH_COST)
                for A in Assign
            )
            pair_cost_matrix[i, j] = best_cost
            pair_cost_matrix[j, i] = best_cost

# Diagonal stays HIGH_COST
np.fill_diagonal(pair_cost_matrix, HIGH_COST)

df = pd.DataFrame(pair_cost_matrix, index=Students, columns=Students)
print(df)

# -----------------------------
# STEP 2: FORM PAIRS (ROBUST)
# -----------------------------
print("\n=== Running Hungarian Algorithm for Pairing ===")

row_ind, col_ind = linear_sum_assignment(pair_cost_matrix)

paired = set()
pairs = []

for r, c in zip(row_ind, col_ind):
    if r < c:  # ensure each pair only once
        s1 = Students[r]
        s2 = Students[c]
        if s1 not in paired and s2 not in paired:
            pairs.append((s1, s2))
            paired.add(s1)
            paired.add(s2)

print("\nPairs formed:")
for p in pairs:
    print(p)

# -----------------------------
# STEP 3: PAIR → ASSIGNMENT COST MATRIX
# -----------------------------
num_pairs = len(pairs)
num_assign = len(Assign)

pair_assign_cost = np.zeros((num_pairs, num_assign), dtype=int)

print("\n=== Building Pair→Assignment Cost Matrix ===")

for i, (s1, s2) in enumerate(pairs):
    for j, A in enumerate(Assign):
        r1 = assignment_rank[s1].get(A, HIGH_COST)
        r2 = assignment_rank[s2].get(A, HIGH_COST)
        pair_assign_cost[i, j] = r1 + r2

df = pd.DataFrame(pair_assign_cost, index=[f"{a}+{b}" for a,b in pairs], columns=Assign)
print(df)

# -----------------------------
# STEP 4: MINIMAX FAIR ASSIGNMENT
# -----------------------------
print("\n=== Running Fair Assignment (Minimax) ===")

# Precompute sorted unique costs for faster binary search
unique_costs = sorted(set(pair_assign_cost.flatten()))

def feasible_with_threshold(T):
    """Check if we can assign all pairs with max cost ≤ T."""
    filtered = np.where(pair_assign_cost <= T, pair_assign_cost, HIGH_COST)
    row_ind, col_ind = linear_sum_assignment(filtered)

    # Every pair must get a valid assignment
    for r, c in zip(row_ind, col_ind):
        if filtered[r, c] == HIGH_COST:
            return False

    # Assignments must be unique
    if len(set(col_ind)) != num_pairs:
        return False

    return True

# Binary search over unique costs
low, high = 0, len(unique_costs) - 1
best_T = HIGH_COST

while low <= high:
    mid = (low + high) // 2
    T = unique_costs[mid]

    if feasible_with_threshold(T):
        best_T = T
        high = mid - 1
    else:
        low = mid + 1

print(f"\nFairness threshold found: T = {best_T}")

# Final assignment
filtered = np.where(pair_assign_cost <= best_T, pair_assign_cost, HIGH_COST)
row_ind, col_ind = linear_sum_assignment(filtered)

print("\n=== Final Pair → Assignment Results ===")
for r, c in zip(row_ind, col_ind):
    s1, s2 = pairs[r]
    assignment = Assign[c]
    cost = pair_assign_cost[r, c]
    print(f"Pair ({s1}, {s2}) → Assignment {assignment} (cost {cost})")

print("\nTotal pairs:", len(pairs))
