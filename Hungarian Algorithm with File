import numpy as np
from scipy.optimize import linear_sum_assignment

import pandas as pd

df = pd.read_excel("/content/tiral 3.xlsx", header=None)


# Students list
Students = df[0].tolist()

# All assignments that appear anywhere in the file
Assign = sorted(set(df.iloc[:, 1:].values.flatten()))

# Build assignment_rank: student → {assignment: rank}
assignment_rank = {}

for _, row in df.iterrows():
    student = row[0]
    prefs = row[1:].dropna().tolist()  # remove empty cells if any

    assignment_rank[student] = {
        assignment: rank
        for rank, assignment in enumerate(prefs, start=1)
    }


HIGH_COST = 999



# -----------------------------
# STEP 1: PAIR COMPATIBILITY
# -----------------------------
n = len(Students)
pair_cost_matrix = np.zeros((n, n), dtype=int)

print("\n=== Building Pair Compatibility Matrix ===")

for i, s1 in enumerate(Students):
    for j, s2 in enumerate(Students):

        if s1 == s2:
            pair_cost_matrix[i, j] = HIGH_COST
            continue

        best_cost = HIGH_COST

        for A in Assign:
            r1 = assignment_rank[s1].get(A, HIGH_COST)
            r2 = assignment_rank[s2].get(A, HIGH_COST)
            best_cost = min(best_cost, r1 + r2)

        pair_cost_matrix[i, j] = best_cost

