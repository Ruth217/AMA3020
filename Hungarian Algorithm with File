# -----------------------------
# STEP 4: FAIR ASSIGNMENT (MINIMAX)
# -----------------------------
print("\n=== Running Fair Assignment (Minimax) ===")

def feasible_with_threshold(T):
    """Check if we can assign all pairs with max cost ≤ T."""
    filtered = np.where(pair_assign_cost <= T, pair_assign_cost, HIGH_COST)
    row_ind, col_ind = linear_sum_assignment(filtered)

    # 1. Every pair must get a valid assignment
    for r, c in zip(row_ind, col_ind):
        if filtered[r, c] == HIGH_COST:
            return False

    # 2. Assignments must be unique
    if len(set(col_ind)) != num_pairs:
        return False

    return True

# Binary search for minimum possible max cost
low, high = 1, HIGH_COST
best_T = HIGH_COST

while low <= high:
    mid = (low + high) // 2
    print(f"Checking threshold T = {mid}")

    if feasible_with_threshold(mid):
        best_T = mid
        high = mid - 1
    else:
        low = mid + 1

print(f"\nFairness threshold found: T = {best_T}")

# Final assignment using threshold
filtered = np.where(pair_assign_cost <= best_T, pair_assign_cost, HIGH_COST)
row_ind, col_ind = linear_sum_assignment(filtered)

print("\n=== Final Pair → Assignment Results ===")
