# -----------------------------
# STEP 3: PAIR → ASSIGNMENT COST MATRIX
# -----------------------------
num_pairs = len(pairs)
num_assign = len(Assign)

pair_assign_cost = np.zeros((num_pairs, num_assign), dtype=int)

print("\n=== Building Pair→Assignment Cost Matrix ===")

for i, (s1, s2) in enumerate(pairs):
    for j, A in enumerate(Assign):
        r1 = assignment_rank[s1].get(A, HIGH_COST)
        r2 = assignment_rank[s2].get(A, HIGH_COST)
        pair_assign_cost[i, j] = r1 + r2

print(pair_assign_cost)

import pandas as pd

